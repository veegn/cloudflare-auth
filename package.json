{
  "name": "cloudflare-auth",
  "version": "1.0.0",
  "description": "Simple auth service on Cloudflare Workers with D1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create cloudflare-auth-db",
    "db:schema:local": "wrangler d1 execute cloudflare-auth-db --local --file=./schema.sql",
    "db:schema:remote": "wrangler d1 execute cloudflare-auth-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "playwright": "^1.63.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.0.0"
  }
}
