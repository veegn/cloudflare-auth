{
  "name": "cloudflare-auth",
  "version": "0.3.0",
  "description": "Auth service on Cloudflare Workers (Rust) with D1",
  "private": true,
  "scripts": {
    "build": "worker-build --release",
    "check": "cargo check --target wasm32-unknown-unknown",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create cloudflare-auth-db",
    "db:schema:local": "wrangler d1 execute cloudflare-auth-db --local --file=./schema.sql",
    "db:schema:remote": "wrangler d1 execute cloudflare-auth-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.0.0"
  }
}
